# Multi-stage build for Sequential Thinking MCP Server with comprehensive LSP support
FROM node:18-slim AS builder

# Install system dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    gnupg \
    wget \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install .NET SDK
RUN wget https://packages.microsoft.com/config/debian/11/packages-microsoft-prod.deb -O packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y dotnet-sdk-8.0 \
    && rm -rf /var/lib/apt/lists/*

# Install Rust for rust-analyzer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add rust-analyzer

# Install Go
RUN wget https://go.dev/dl/go1.21.0.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.21.0.linux-amd64.tar.gz \
    && rm go1.21.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Set working directory
WORKDIR /app

# Copy package files
COPY package.json package-lsp.json tsconfig.json ./
COPY src/sequentialthinking/ ./src/sequentialthinking/

# Install Node.js dependencies
RUN npm install

# Install comprehensive LSP server suite
# .NET Development
RUN dotnet tool install --global omnisharp

# Frontend Development
RUN npm install -g typescript-language-server typescript
RUN npm install -g @angular/language-server
RUN npm install -g vscode-css-language-server
RUN npm install -g vscode-html-language-server
RUN npm install -g vscode-json-language-server

# Configuration & DevOps
RUN npm install -g yaml-language-server
RUN npm install -g docker-langserver

# Additional Language Servers
RUN pip3 install python-lsp-server
RUN go install golang.org/x/tools/gopls@latest

# Download XML Language Server (LemMinX)
RUN wget https://github.com/eclipse/lemminx/releases/latest/download/lemminx-uber.jar -O /usr/local/bin/lemminx.jar

# Build the project
WORKDIR /app/src/sequentialthinking
RUN npm run build:lsp

# Production stage
FROM node:18-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    python3 \
    python3-pip \
    curl \
    openjdk-11-jre \
    && rm -rf /var/lib/apt/lists/*

# Install .NET Runtime
RUN wget https://packages.microsoft.com/config/debian/11/packages-microsoft-prod.deb -O packages-microsoft-prod.deb \
    && dpkg -i packages-microsoft-prod.deb \
    && rm packages-microsoft-prod.deb \
    && apt-get update \
    && apt-get install -y aspnetcore-runtime-8.0 \
    && rm -rf /var/lib/apt/lists/*

# Install Rust runtime for rust-analyzer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"
RUN rustup component add rust-analyzer

# Install Go
RUN wget https://go.dev/dl/go1.21.0.linux-amd64.tar.gz \
    && tar -C /usr/local -xzf go1.21.0.linux-amd64.tar.gz \
    && rm go1.21.0.linux-amd64.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"

# Install LSP servers in production
RUN dotnet tool install --global omnisharp
RUN npm install -g typescript-language-server typescript @angular/language-server
RUN npm install -g vscode-css-language-server vscode-html-language-server vscode-json-language-server
RUN npm install -g yaml-language-server docker-langserver
RUN pip3 install python-lsp-server
RUN go install golang.org/x/tools/gopls@latest

# Copy XML Language Server
COPY --from=builder /usr/local/bin/lemminx.jar /usr/local/bin/lemminx.jar

# Create app directory
WORKDIR /app

# Copy built application
COPY --from=builder /app/src/sequentialthinking/dist ./
COPY --from=builder /app/src/sequentialthinking/package-lsp.json ./package.json

# Install only production dependencies
RUN npm ci --only=production

# Create non-root user
RUN useradd -m -s /bin/bash mcpuser
RUN chown -R mcpuser:mcpuser /app
USER mcpuser

# Expose environment variables
ENV DISABLE_THOUGHT_LOGGING=false
ENV DEBUG=false
ENV LOG_LEVEL=info
ENV DOTNET_ROOT=/usr/share/dotnet
ENV PATH="${PATH}:/root/.dotnet/tools:/usr/local/go/bin"

# Set entrypoint
ENTRYPOINT ["node", "lsp-enhanced-index.js"]
